# Build output — regenerated by BUILD_AXVON.bat
backend/target/
target/
frontend/dist/
electron/frontend-dist/
electron/dist/
electron/backend/*.jar
dist/
out/
build/

# Bundled Java runtime (~180 MB) — BUILD_AXVON.bat downloads it
electron/jre/

# Dependencies
node_modules/

# Installer download cache
_tools/
_build_tools/

# The backend jar is copied here by BUILD_AXVON.bat, never committed
electron/backend/
*.jar
!backend/.mvn/wrapper/*.jar

# Local data and logs
*.log
logs/
.axvon/

# H2 database files — these hold real HR data, never commit them
*.db
*.mv.db
*.trace.db
*.lock.db

# Database snapshots written on every launch
backups/

# Secrets and local config
.env
.env.*
!.env.example
*.key
jwt.key

# Editor / OS
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# Local marketing drafts — not part of the product
marketing/
